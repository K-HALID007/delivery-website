# Prime Dispatcher Frontend Environment Configuration

# Backend API URL (Points to the active Express server on port 5000)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Application Branding
NEXT_PUBLIC_APP_NAME=Prime Dispatcher
NEXT_PUBLIC_APP_DESCRIPTION=Professional Courier and Shipment Tracking System

# Note for Production Deployment:
# Set NEXT_PUBLIC_API_URL and NEXT_PUBLIC_BACKEND_URL in Vercel project settings to your backend production URL